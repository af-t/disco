{
  "name": "disco",
  "version": "1.3.1",
  "description": "Discord bot application.",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "test": "node --experimental-test-module-mocks --test",
    "start": "node src/index.js",
    "serve": "node src/store/server.js",
    "lint": "eslint '**/*.js'",
    "lint:fix": "eslint --fix '**/*.js'",
    "format": "prettier --check '**/*.js'",
    "format:fix": "prettier --write '**/*.js'",
    "check": "npm run lint && npm run format && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/af-t/disco.git"
  },
  "keywords": [
    "bot",
    "bot-framework",
    "discord",
    "api",
    "discord-bot",
    "discord-api"
  ],
  "author": "Angga Firman",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/af-t/disco/issues"
  },
  "homepage": "https://github.com/af-t/disco#readme",
  "engines": {
    "node": ">=22.3.0"
  },
  "dependencies": {
    "openrouter": "github:af-t/openrouter#v1.2.0",
    "opusscript": "^0.1.1",
    "tweetnacl": "^1.0.3",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3"
  }
}
