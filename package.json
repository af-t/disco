{
  "name": "disco",
  "version": "1.7.5",
  "description": "Discord bot application.",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "test": "node --experimental-test-module-mocks --test",
    "start": "node src/index.js",
    "serve": "node src/store/server.js",
    "lint": "eslint '**/*.js'",
    "lint:fix": "eslint --fix '**/*.js'",
    "format": "prettier --check '**/*.js'",
    "format:fix": "prettier --write '**/*.js'",
    "check": "npm run lint && npm run format && npm test",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:delete": "pm2 delete ecosystem.config.cjs",
    "pm2:logs": "pm2 logs",
    "pm2:status": "pm2 status"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/af-t/disco.git"
  },
  "keywords": [
    "bot",
    "bot-framework",
    "discord",
    "api",
    "discord-bot",
    "discord-api"
  ],
  "author": "Angga Firman",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/af-t/disco/issues"
  },
  "homepage": "https://github.com/af-t/disco#readme",
  "engines": {
    "node": ">=22.3.0"
  },
  "dependencies": {
    "@af-t/agent-sdk": "git+https://github.com/af-t/agent-sdk.git#v3.2.2",
    "opusscript": "^0.1.1",
    "tweetnacl": "^1.0.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "pm2": "^7.0.1",
    "prettier": "^3.9.1"
  },
  "overrides": {
    "pm2": {
      "js-yaml": "^4.1.2",
      "ws": "^8.21.0"
    }
  }
}
