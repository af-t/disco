# Required
DISCORD_TOKEN=your_discord_bot_token_here

# Storage
# STORE_SERVER_URL=http://localhost:3000
STORE_SERVER_PORT=3000
# STORE_DATA_PATH=/path/to/store/data  # server-side disk path (default: ./storage/db)

# External services (optional — only needed for respective commands)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-001
# OPENROUTER_ORDER=provider1,provider2  # comma-separated provider priority order
# OPENROUTER_ONLY=provider1,provider2   # restrict to specific providers only
# OPENROUTER_MAX_COMPLETION_TOKENS=4096 # max output tokens
OPENROUTER_MAX_TURNS=120                # per-loop turn cap for pooled agents
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small  # embeddings for semantic memory recall
# TAVILY_API_KEY=your_tavily_api_key_here  # API key for WebSearch tool
# SPOTIFY_CLIENT_ID=your_spotify_client_id_here
# SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Discord Gateway (advanced)
# DISCORD_GATEWAY_URL=wss://gateway.discord.gg
# DISCORD_API_BASE=https://discord.com/api/v10

# Slash commands auto-defer before Discord's 3s deadline (default 2000ms).
# Lower it on high-latency hosts so the deferral still arrives in time.
# DISCORD_AUTODEFER_MS=2000

# Intents (comma-separated; unset = 13 essential intents)
# DISCORD_INTENTS=GUILDS,GUILD_MEMBERS,GUILD_MESSAGES,MESSAGE_CONTENT

# Reconnection
# DISCORD_RECONNECT_DELAY=5000
# DISCORD_RECONNECT_LIMIT=5
# DISCORD_MAX_RETRIES=3

# Natural AI mode (channel participant). 0 = AI disabled entirely; 1 = AI on.
# When 0, the .ai/.openrouter/.chat commands return a "not enabled" message
# (the legacy per-user AI implementation has been removed).
AI_NATURAL_MODE=0
AI_DEBOUNCE_MS=4000
AI_FORCE_DEBOUNCE_MS=500
AI_CHANNEL_COOLDOWN_MS=20000
AI_DAILY_LIMIT=500
AI_BUFFER_SIZE=30
AI_COMPACT_THRESHOLD=100
AI_FETCH_HISTORY_MAX=50

# Child-process agent pool
AI_MAX_AGENTS=16                 # max concurrent forked agent processes
AI_AGENT_IDLE_MS=300000          # evict an agent child after this idle time
AI_AGENT_RESPAWN_COOLDOWN_MS=30000  # cooldown for an agent key after a startup crash
