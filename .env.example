# Required
DISCORD_TOKEN=your_discord_bot_token_here

# Storage
# STORE_SERVER_URL=http://localhost:3000
STORE_SERVER_PORT=3000
# STORE_DATA_PATH=/path/to/store/data  # server-side disk path (default: ./storage/db)

# External services (optional — only needed for respective commands)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-001
# SPOTIFY_CLIENT_ID=your_spotify_client_id_here
# SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Discord Gateway (advanced)
# DISCORD_GATEWAY_URL=wss://gateway.discord.gg
# DISCORD_API_BASE=https://discord.com/api/v10

# Intents (comma-separated; unset = 13 essential intents)
# DISCORD_INTENTS=GUILDS,GUILD_MEMBERS,GUILD_MESSAGES,MESSAGE_CONTENT

# Reconnection
# DISCORD_RECONNECT_DELAY=5000
# DISCORD_RECONNECT_LIMIT=5
# DISCORD_MAX_RETRIES=3
